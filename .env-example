# The URL to use as a source when rewriting the URLs from the tuners
# If this is blank, it will try to guess based on the request url/headers
HD_HOMEY_PROXY_HOST=

# The path to store the database files
HD_HOMEY_DB_PATH=./data/db/hd_homey.db

# Transcoding temporary files (optional - defaults to ${HD_HOMEY_DB_PATH}/transcoding)
# HD_HOMEY_TRANSCODE_DIR=./data/transcoding

# FFmpeg path (optional - auto-detected from PATH)
# FFMPEG_PATH=/usr/bin/ffmpeg

# The string to encrypt session tokens with
AUTH_SECRET="some-random-string"

# Better-Auth URL for redirects (optional - auto-detected from request if not set)
# Set this in production if behind a proxy or if auto-detection fails
BETTER_AUTH_URL="http://localhost:3000"

# Sub-path prefix for reverse proxy deployments (optional, default: empty = root path)
# When deploying behind a reverse proxy at a sub-path, set this to your prefix.
# Must start with "/" and must NOT end with "/" (e.g., "/hd-homey").
# Also set BETTER_AUTH_URL to include the full origin (e.g., "http://localhost:3000").
# HD_HOMEY_BASE_PATH=/hd-homey
