<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/serverListFragment">

    <!-- Server List Fragment (Phase 1.2) -->
    <fragment
        android:id="@+id/serverListFragment"
        android:name="com.hdhomey.app.ui.servers.ServerListFragment"
        android:label="Your Servers">
        <action
            android:id="@+id/action_serverList_to_addServer"
            app:destination="@id/addServerFragment" />
        <action
            android:id="@+id/action_serverList_to_authentication"
            app:destination="@id/authenticationFragment" />
    </fragment>

    <!-- Add Server Fragment (Phase 1.2) -->
    <fragment
        android:id="@+id/addServerFragment"
        android:name="com.hdhomey.app.ui.servers.AddServerFragment"
        android:label="Add Server">
        <!-- Automatically pops back to server list on success/cancel -->
    </fragment>

    <!-- Authentication Fragment (Phase 1.3) -->
    <fragment
        android:id="@+id/authenticationFragment"
        android:name="com.hdhomey.app.ui.auth.AuthenticationFragment"
        android:label="Pair Your Device">
        <argument
            android:name="serverId"
            app:argType="string"
            app:nullable="false" />
        <action
            android:id="@+id/action_authentication_to_success"
            app:destination="@id/successFragment" />
    </fragment>

    <!-- Success Fragment (Phase 1.3) -->
    <fragment
        android:id="@+id/successFragment"
        android:name="com.hdhomey.app.ui.success.SuccessFragment"
        android:label="Success">
        <!-- After success, navigate back to server list -->
        <action
            android:id="@+id/action_success_to_serverList"
            app:destination="@id/serverListFragment"
            app:popUpTo="@id/serverListFragment"
            app:popUpToInclusive="true" />
    </fragment>

</navigation>
