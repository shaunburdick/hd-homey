<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Base.Theme.HdHomey" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/hd_homey_blue</item>
        <item name="colorPrimaryDark">@color/hd_homey_blue_dark</item>
        <item name="colorAccent">@color/hd_homey_blue</item>
    </style>

    <style name="Theme.HdHomey" parent="Base.Theme.HdHomey" />

    <!-- Android TV Theme -->
    <style name="Theme.HdHomey.Leanback" parent="Theme.Leanback">
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:colorPrimary">@color/hd_homey_blue</item>
        <item name="android:colorAccent">@color/hd_homey_blue</item>
    </style>

    <!-- Text styles for 10-foot UI -->
    <style name="TextAppearance.HdHomey.Title" parent="TextAppearance.AppCompat.Display1">
        <item name="android:textSize">48sp</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="TextAppearance.HdHomey.Code" parent="TextAppearance.AppCompat.Display4">
        <item name="android:textSize">96sp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.2</item>
    </style>
</resources>
