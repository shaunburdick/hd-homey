<?xml version="1.0" encoding="utf-8"?>
<!--
    item_channel.xml — Single channel row in the channel list RecyclerView.

    Layout: CardView root (matches item_server.xml pattern) containing a horizontal
    ConstraintLayout with three regions:
      • Left  : channel_number  — large numeric label
      • Center: channel_name + hd_badge  — channel title with optional HD tag
      • Right : favorite_icon  — star toggle for bookmarked channels

    D-pad focus (T044):
      - CardView is focusable="true" (focusableInTouchMode="false" keeps TV remote
        navigation separate from touch scrolling).
      - card_lift animator (reused from item_server.xml) raises translationZ on
        state_focused / state_pressed, giving a clear visual elevation cue.
      - app:cardBackgroundColor cycles between surface_dark (default) and
        surface_dark_elevated (focused) via the card's own foreground state ripple;
        the elevation change is the primary focus indicator.
      - nextFocusUp / nextFocusDown point back to self as placeholders; the adapter
        (ChannelAdapter) or RecyclerView's default D-pad delegate will override these
        at bind-time when it wires consecutive item IDs.
-->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/channel_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/tv_margin_small"
    android:layout_marginVertical="4dp"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:foreground="?android:attr/selectableItemBackground"
    android:nextFocusDown="@id/channel_card"
    android:nextFocusUp="@id/channel_card"
    android:stateListAnimator="@animator/card_lift"
    app:cardBackgroundColor="@color/surface_dark"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <!--
        Root horizontal container.
        Three sections:
          [channel_number | (channel_name + hd_badge) | favorite_icon]
    -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/touch_target_min"
        android:paddingHorizontal="@dimen/tv_margin_small"
        android:paddingVertical="12dp">

        <!-- ═══════════════════════════════════════════════════════════
             Channel Number — left anchor, large readable numeral for
             10-foot UI legibility.
             ═══════════════════════════════════════════════════════════ -->
        <TextView
            android:id="@+id/channel_number"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="5.1" />

        <!-- ═══════════════════════════════════════════════════════════
             Favorite Star Icon — right anchor, toggles bookmark state.
             ImageView src references @drawable/ic_star_outline (unfavorited)
             or @drawable/ic_star_filled (favorited); the adapter swaps the
             drawable at bind-time.  Falls back to the system star asset so
             the layout renders in preview without custom drawables present.
             ═══════════════════════════════════════════════════════════ -->
        <ImageView
            android:id="@+id/favorite_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/favorite_toggle_description"
            android:scaleType="fitCenter"
            android:src="@android:drawable/btn_star"
            app:tint="@color/text_secondary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="VectorDrawableCompat" />

        <!-- ═══════════════════════════════════════════════════════════
             Channel Name — center, bold title.
             Constrained between channel_number (start) and favorite_icon
             (end) so it fills all remaining horizontal space.
             ═══════════════════════════════════════════════════════════ -->
        <TextView
            android:id="@+id/channel_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/hd_badge"
            app:layout_constraintEnd_toStartOf="@id/favorite_icon"
            app:layout_constraintStart_toEndOf="@id/channel_number"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="NBC (KNBC)" />

        <!-- ═══════════════════════════════════════════════════════════
             HD Badge — small label below the channel name, visible only
             when the channel carries an HD stream.  The adapter toggles
             visibility between VISIBLE and GONE at bind-time.
             ═══════════════════════════════════════════════════════════ -->
        <TextView
            android:id="@+id/hd_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@color/hd_homey_blue_dark"
            android:paddingHorizontal="6dp"
            android:paddingVertical="1dp"
            android:text="@string/hd_badge_label"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@id/channel_name"
            app:layout_constraintTop_toBottomOf="@id/channel_name"
            tools:visibility="visible" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
