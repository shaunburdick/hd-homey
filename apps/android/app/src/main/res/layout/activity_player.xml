<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_player.xml
  Full-screen video player for HD Homey Android TV app.

  Root is a FrameLayout so overlay layers can be z-ordered naturally without a
  heavyweight constraint-solving pass — the simplest and most performant layout
  for a "stacked glass-pane" pattern.

  Layer order (back → front):
    1. PlayerView    — fills entire screen; owns play/pause/seek chrome.
    2. channel_info_overlay — semi-transparent OSD chip, top-left corner.
    3. player_controls — custom D-pad-friendly play/pause + exit overlay.
    4. player_loading_state — centred spinner; shown while ExoPlayer buffers.
    5. player_error_state   — centred message + retry; shown on fatal error.

  States (mutually exclusive; driven by PlayerActivity / PlayerViewModel):
    • Playing:  player_view visible, overlays gone
    • Loading:  player_loading_state visible (VISIBLE), others gone
    • Error:    player_error_state visible (VISIBLE), loading gone
  Channel info overlay can be shown/hidden independently of the other states.
  Player controls overlay is shown transiently on user interaction and auto-hides
  after 3 seconds of inactivity.

  View IDs consumed by PlayerActivity:
    player_view            — ExoPlayer PlayerView
    channel_info_overlay   — toggleable OSD wrapper
    player_channel_number  — channel number label
    player_channel_name    — channel name label
    player_controls        — custom D-pad controls overlay
    player_loading_state   — indeterminate ProgressBar
    player_error_state     — error container
    player_error_message   — error description TextView
    player_retry_button    — retry action Button
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <!-- ── Layer 1: ExoPlayer surface ────────────────────────────────────────
         use_controller="true"   — enables built-in play/pause/seek/timeline bar.
         show_buffering="when_playing" — shows a spinner inside the PlayerView
             surface only when content is playing and re-buffers mid-stream; the
             dedicated player_loading_state below covers the initial load phase.
         resize_mode="fit"       — letterbox/pillarbox to preserve aspect ratio
             without cropping, matching Android TV best practice.
    -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:show_buffering="when_playing"
        app:use_controller="true" />

    <!-- ── Layer 2: Channel info OSD — top-left corner ───────────────────────
         Shown briefly after channel selection and dismissed after a timeout
         (handled by PlayerActivity). Uses tv_margin_small (16dp) padding to
         keep content away from the very edge, matching the 10-foot UI safe-area
         used in other screens. Alpha on the number label de-emphasises it
         relative to the bolder channel name below it.
    -->
    <LinearLayout
        android:id="@+id/channel_info_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="@dimen/tv_margin_small"
        android:visibility="gone"
        tools:visibility="visible">

        <!-- Channel number — smaller, slightly dimmed -->
        <TextView
            android:id="@+id/player_channel_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.8"
            android:contentDescription="@string/player_channel_number_description"
            android:text=""
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_caption"
            tools:text="7.1" />

        <!-- Channel name — prominent, bold -->
        <TextView
            android:id="@+id/player_channel_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/player_channel_name_description"
            android:text=""
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="PBS HD" />

    </LinearLayout>

    <!-- ── Layer 3: Player controls overlay ─────────────────────────────────
         Custom D-pad-friendly controls rendered on top of the video surface.
         Hidden by default; shown transiently on user interaction then auto-
         hidden after 3 seconds via PlayerActivity's hideControlsRunnable.

         Visibility is driven entirely by PlayerActivity — the view itself
         does not hide/show itself. When GONE, touch events pass through to
         the PlayerView below so ExoPlayer's built-in controller still works.
    -->
    <com.hdhomey.app.ui.player.PlayerControlsView
        android:id="@+id/player_controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        tools:visibility="gone" />

    <!-- ── Layer 4: Loading state — centred progress indicator ───────────────
         Shown during the initial buffer/prepare phase before playback begins.
         indeterminateTint colours the spinner in the project's accent blue so
         it visually matches the rest of the UI rather than using the system
         default grey.
    -->
    <ProgressBar
        android:id="@+id/player_loading_state"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:contentDescription="@string/player_loading_description"
        android:indeterminateTint="@color/hd_homey_blue"
        android:visibility="gone"
        tools:visibility="gone" />

    <!-- ── Layer 5: Error state — centred message + retry ────────────────────
         Shown when ExoPlayer reports a fatal playback error. The message text
         is populated at runtime by PlayerActivity. The retry button is sized
         to meet the 48dp minimum touch/D-pad target and is explicitly focusable
         so D-pad navigation lands on it correctly on Android TV.
    -->
    <LinearLayout
        android:id="@+id/player_error_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="gone">

        <!-- Error icon — uses system alert drawable; tinted red via attr -->
        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginBottom="@dimen/tv_margin_small"
            android:contentDescription="@string/player_error_icon_description"
            android:src="@android:drawable/ic_dialog_alert"
            app:tint="@color/error_red" />

        <!-- Error description — populated at runtime -->
        <TextView
            android:id="@+id/player_error_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/player_error_message_description"
            android:gravity="center"
            android:padding="@dimen/tv_margin_small"
            android:text=""
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_body"
            tools:text="Could not connect to stream" />

        <!-- Retry button — D-pad focusable, 48dp min height, brand blue -->
        <Button
            android:id="@+id/player_retry_button"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target_min"
            android:layout_marginTop="@dimen/tv_margin_medium"
            android:backgroundTint="@color/hd_homey_blue"
            android:contentDescription="@string/player_retry_description"
            android:focusable="true"
            android:minWidth="160dp"
            android:text="@string/try_again"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_body" />

    </LinearLayout>

</FrameLayout>
