{
  "name": "@hd-homey/web",
  "version": "1.0.0-beta.6",
  "license": "AGPL-3.0-only",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "prebuild": "if [ \"$SKIP_PREBUILD\" != \"true\" ]; then npm run lint; fi",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "typecheck": "tsc --noEmit",
    "test": "npm run lint && npm run typecheck && npm run test:unit",
    "test:ci": "npm run lint && npm run typecheck && npm run test:coverage",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio --host localhost --port 3002 --verbose",
    "db:migrate": "tsx src/scripts/migrate.ts"
  },
  "dependencies": {
    "@exampledev/new.css": "^1.1.3",
    "@sinclair/typebox": "^0.34.14",
    "better-auth": "^1.4.3",
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "^0.45.2",
    "drizzle-typebox": "^0.3.3",
    "hls.js": "^1.6.14",
    "next": "^16.0.10",
    "pino": "^10.1.0",
    "pino-pretty": "^13.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "swr": "^2.3.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.2.9",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.0.10",
    "drizzle-kit": "^0.31.7",
    "eslint": "^10.5.0",
    "eslint-config-next": "^16.0.3",
    "eslint-config-shaunburdick": "^8.1.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "jsdom": "^29.1.1",
    "msw": "^2.12.2",
    "pa11y": "^9.0.1",
    "sharp": "^0.35.1",
    "tsx": "^4.19.2",
    "typescript": "^6.0.0",
    "vitest": "^4.0.10"
  }
}
